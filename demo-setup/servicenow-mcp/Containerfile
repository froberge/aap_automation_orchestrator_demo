FROM registry.access.redhat.com/ubi9/python-312:latest

USER 0
WORKDIR /opt/app

COPY requirements.txt .
RUN python -m venv /opt/app/venv \
    && /opt/app/venv/bin/pip install --no-cache-dir -r requirements.txt

COPY servicenow_mcp /opt/app/servicenow_mcp

RUN chown -R 1001:0 /opt/app \
    && chmod -R g=u /opt/app

USER 1001
ENV PYTHONUNBUFFERED=1 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8080

EXPOSE 8080
# The UBI Python image entrypoint puts its own interpreter first on PATH.
# Call the virtualenv interpreter directly so `mcp` is importable.
ENTRYPOINT ["/opt/app/venv/bin/python", "-m", "servicenow_mcp"]
